---
// Structured to match the original site's Sales Results page (Miles, Nov 18, 2026):
// headline → "Actual items sold" chart → site views → phone → email | address → tagline.
import BaseLayout from '../layouts/BaseLayout.astro';
import ResultsTable from '../components/ResultsTable.astro';
import { results } from '../data/consign.js';
import { site } from '../data/site.js';
const a = site.address;
---
<BaseLayout title="Sales Results" description="Real items Essex Consignment has sold, from a Norman Rockwell painting to a 1984 Ferrari, compared with their auction estimates.">
  <section class="mx-auto max-w-5xl px-4 pt-12 pb-8 text-center">
    <h1 class="text-[2.8125rem] font-black leading-[1.1] tracking-tight sm:text-6xl">Sell your “stuff”<br />and put more in your pocket.</h1>
  </section>

  <section class="mx-auto max-w-5xl px-4" aria-label="Actual items sold">
    <ResultsTable items={results} />
  </section>

  <section class="mx-auto max-w-5xl px-4 pt-10 pb-16 text-center">
    <h2 class="text-xl font-bold sm:text-2xl">{site.monthlyViews} site views per month</h2>
    <a href={site.phoneHref} class="mt-5 inline-block rounded-btn bg-burgundy-800 px-8 py-4 text-lg font-semibold uppercase text-white hover:bg-burgundy-700 sm:px-14 sm:text-xl">Essex Consignment <span class="whitespace-nowrap">{site.phone}</span></a>
    <p class="mt-5 text-lg leading-snug sm:text-xl">
      <a href={`mailto:${site.email}`} class="block underline-offset-4 hover:underline">{site.email}</a>
      <span aria-hidden="true" class="block">|</span>
      <span class="block">{a.street}, {a.city}, {a.region} {a.postalCode}</span>
    </p>
    <p class="mt-6 text-3xl font-extrabold leading-tight text-burgundy-800 sm:text-5xl">{site.tagline}</p>
  </section>
</BaseLayout>
