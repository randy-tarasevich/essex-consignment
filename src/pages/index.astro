---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedGallery from '../components/FeaturedGallery.astro';
import GoogleRating from '../components/GoogleRating.astro';
import { site } from '../data/site.js';
import { stats, results, usd } from '../data/consign.js';
const highlights = results.filter((r) => r.featured).slice(0, 3);
---
<BaseLayout>
  <!-- Featured items lead the page (designer direction, Nov 2026: hero removed). -->
  <FeaturedGallery headingLevel="h1" eyebrow="Essex Consignment · Estate furniture & objets d'art · Essex, CT" />
  <!-- Consign prompt: keeps sellers' path near the top now that the hero is gone -->
  <section class="bg-burgundy-800 text-white" aria-label="Consign with us">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-6">
      <p class="font-display text-xl sm:text-2xl">Have something to sell? <span class="text-burgundy-100">{site.tagline}</span></p>
      <a href="/consign/" class="rounded-btn bg-white px-6 py-3 text-xs font-semibold uppercase tracking-[0.2em] text-burgundy-800 hover:bg-burgundy-50">Consign with us</a>
    </div>
  </section>
  <!-- Trust stats -->
  <section class="bg-white border-b border-burgundy-100" aria-label="Essex Consignment by the numbers">
    <div class="mx-auto max-w-6xl px-4 py-8 text-center">
      <ul class="grid gap-6 sm:grid-cols-3">
        {stats.map((s) => (
          <li>
            <p class="font-display text-2xl font-bold text-burgundy-800">{s.value}</p>
            <p class="text-sm uppercase tracking-wide">{s.label}</p>
          </li>
        ))}
      </ul>
      <div class="mt-6"><GoogleRating tone="light" /></div>
    </div>
  </section>
  <!-- Sales results highlights -->
  <section aria-labelledby="sold-heading">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 id="sold-heading" class="text-3xl font-bold">Sell your “stuff” and put more in your pocket</h2>
      <p class="mt-2 max-w-2xl">Real items we’ve sold, compared with their auction estimates.</p>
      <ul class="mt-8 grid gap-4 sm:grid-cols-3">
        {highlights.map((r) => (
          <li class="bg-white p-5 ring-1 ring-burgundy-100 frame">
            <h3 class="text-lg">{r.item}</h3>
            <p class="mt-2 text-sm">Auction estimate {usd(r.estimate)}</p>
            <p class="font-serif lining-nums text-2xl font-bold text-burgundy-700">Sold for {usd(r.sold)}</p>
          </li>
        ))}
      </ul>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/results/" class="rounded-btn bg-burgundy-700 px-6 py-3 font-semibold text-white hover:bg-burgundy-800">See all sales results</a>
        <a href="/consign/" class="rounded-btn border border-burgundy-700 px-6 py-3 font-semibold text-burgundy-700 hover:bg-burgundy-50">What we accept</a>
      </div>
    </div>
  </section>
</BaseLayout>
