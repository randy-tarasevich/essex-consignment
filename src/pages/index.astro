---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedGallery from '../components/FeaturedGallery.astro';
import GoogleRating from '../components/GoogleRating.astro';
import { site } from '../data/site.js';
import { stats, results, usd } from '../data/consign.js';
const highlights = results.filter((r) => r.featured).slice(0, 3);
---
<BaseLayout>
  <!-- Hero: engraved-label cartouche floating on the Essex toile -->
  <section class="relative overflow-hidden border-b border-burgundy-100 bg-cream">
    <div class="hero-toile absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-14 sm:py-24">
      <div class="cartouche mx-auto max-w-3xl bg-cream/95 px-6 py-12 text-center sm:px-16 sm:py-16">
        <div class="flex items-center justify-center gap-4 text-burgundy-700" aria-hidden="true">
          <span class="h-px w-16 bg-burgundy-700/40"></span>
          <span class="h-1.5 w-1.5 rotate-45 bg-burgundy-700"></span>
          <span class="h-px w-16 bg-burgundy-700/40"></span>
        </div>
        <p class="mt-5 text-xs font-semibold uppercase tracking-[0.25em] text-burgundy-600">Estate furniture &amp; objets d'art · Essex, CT</p>
        <h1 class="mt-5 text-4xl leading-tight sm:text-6xl">From an ashtray<br /> <em class="italic">to a Picasso</em></h1>
        <div class="mx-auto mt-6 h-1 w-24 border-y border-burgundy-700" aria-hidden="true"></div>
        <p class="mx-auto mt-6 max-w-xl text-lg text-ink/80">{site.tagline} 24 years as a top-rated eBay seller, with buyers worldwide.</p>
        <div class="mt-9 flex flex-wrap justify-center gap-4">
          <a href={site.shopUrl || '#featured-heading'} class="rounded-btn bg-burgundy-800 px-8 py-4 text-xs font-semibold uppercase tracking-[0.2em] text-white hover:bg-burgundy-700">Shop now</a>
          <a href="/consign/" class="rounded-btn border border-burgundy-800 px-8 py-4 text-xs font-semibold uppercase tracking-[0.2em] text-burgundy-800 hover:bg-burgundy-50">Consign with us</a>
        </div>
        <div class="mt-8"><GoogleRating tone="light" /></div>
      </div>
    </div>
  </section>
  <!-- Trust stats -->
  <section class="bg-white/60 border-y border-burgundy-100" aria-label="Essex Consignment by the numbers">
    <ul class="mx-auto max-w-6xl px-4 py-8 grid gap-6 text-center sm:grid-cols-3">
      {stats.map((s) => (
        <li>
          <p class="font-display text-2xl font-bold text-burgundy-800">{s.value}</p>
          <p class="text-sm uppercase tracking-wide">{s.label}</p>
        </li>
      ))}
    </ul>
  </section>
  <FeaturedGallery />
  <!-- Sales results highlights -->
  <section class="bg-white/60 border-y border-burgundy-100" aria-labelledby="sold-heading">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 id="sold-heading" class="text-3xl font-bold">Sell your “stuff” and put more in your pocket</h2>
      <p class="mt-2 max-w-2xl">Real items we’ve sold, compared with their auction estimates.</p>
      <ul class="mt-8 grid gap-4 sm:grid-cols-3">
        {highlights.map((r) => (
          <li class="bg-cream p-5 ring-1 ring-burgundy-100 frame">
            <h3 class="text-lg">{r.item}</h3>
            <p class="mt-2 text-sm">Auction estimate {usd(r.estimate)}</p>
            <p class="font-serif lining-nums text-2xl font-bold text-burgundy-700">Sold for {usd(r.sold)}</p>
          </li>
        ))}
      </ul>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/results/" class="rounded-btn bg-burgundy-700 px-6 py-3 font-semibold text-white hover:bg-burgundy-800">See all sales results</a>
        <a href="/consign/" class="rounded-btn border border-burgundy-700 px-6 py-3 font-semibold text-burgundy-700 hover:bg-burgundy-50">What we accept</a>
      </div>
    </div>
  </section>
</BaseLayout>
