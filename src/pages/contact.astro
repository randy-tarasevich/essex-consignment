---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { site } from '../data/site.js';
---
<BaseLayout title="Contact" description="Contact Essex Consignment at 204 Westbrook Rd, Essex, CT. Call (860) 767-9741.">
  <PageHeader title="Contact & Directions" intro="Questions, appointments, or something to sell? We'd love to hear from you." />
  <section class="mx-auto max-w-6xl px-4 py-12 grid gap-12 lg:grid-cols-2">
    <div class="space-y-3">
      <p class="font-semibold">{site.address.street}, {site.address.city}, {site.address.region} {site.address.postalCode}</p>
      <p><a href={site.phoneHref} class="text-burgundy-700 hover:underline">{site.phone}</a></p>
      <p><a href={`mailto:${site.email}`} class="text-burgundy-700 hover:underline">{site.email}</a></p>
      <p>Hours: {site.hours}</p>
      <!-- TODO: map embed (lazy-loaded) -->
    </div>
    <div>
      <h2 class="text-2xl font-bold">Send us a message</h2>
      <p id="form-error" hidden class="mt-2 text-sm font-semibold text-red-700">Sorry, your message didn't go through. Please try again or call us.</p>
      <script is:inline>
        if (new URLSearchParams(location.search).has('error')) document.getElementById('form-error').hidden = false;
      </script>
      <div class="mt-4"><InquiryForm type="contact" /></div>
    </div>
  </section>
</BaseLayout>
