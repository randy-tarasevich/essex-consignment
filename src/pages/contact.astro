---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { site } from '../data/site.js';
import SocialLinks from '../components/SocialLinks.astro';
---
<BaseLayout title="Contact" description="Contact Essex Consignment at 204 Westbrook Rd, Essex, CT. Call (860) 767-9741.">
  <PageHeader compact title="Contact & Directions" intro="Questions, appointments, or something to sell? We'd love to hear from you." />
  <section class="mx-auto max-w-6xl px-4 pt-6 pb-12 grid gap-12 lg:grid-cols-2">
    <div class="space-y-3">
      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href={site.map.placeUrl} target="_blank" rel="noopener"
          class="inline-flex items-center gap-3 rounded-lg bg-burgundy-700 px-6 py-4 text-xl font-semibold text-white hover:bg-burgundy-800 transition-colors">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Z"/></svg>
          <span>{site.address.street}, {site.address.city}, {site.address.region} {site.address.postalCode}</span>
        </a>
        <a href={site.phoneHref}
          class="inline-flex items-center gap-3 rounded-lg bg-burgundy-700 px-6 py-4 text-xl font-semibold text-white hover:bg-burgundy-800 transition-colors">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1L6.6 10.8Z"/></svg>
          <span>{site.phone}</span>
        </a>
      </div>
      <p><a href={`mailto:${site.email}`} class="text-burgundy-700 hover:underline">{site.email}</a></p>
      <p>Hours: {site.hours}</p>
      <div class="pt-4">
        <p class="text-lg font-semibold">Follow us for new arrivals</p>
        <SocialLinks buttons class="mt-3" />
      </div>
      <div class="pt-4">
        <div class="aspect-[4/3] w-full overflow-hidden rounded-lg border border-gray-300 bg-gray-100">
          <iframe
            src={site.map.embedUrl}
            title={`Map of ${site.name}, ${site.address.street}, ${site.address.city}, ${site.address.region}`}
            class="h-full w-full"
            style="border:0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
        <p class="mt-2"><a href={site.map.placeUrl} target="_blank" rel="noopener" class="text-burgundy-700 hover:underline">Get directions on Google Maps</a></p>
      </div>
    </div>
    <div>
      <h2 class="text-2xl font-bold">Send us a message</h2>
      <p id="form-error" hidden class="mt-2 text-sm font-semibold text-red-700">Sorry, your message didn't go through. Please try again or call us.</p>
      <script is:inline>
        if (new URLSearchParams(location.search).has('error')) document.getElementById('form-error').hidden = false;
      </script>
      <div class="mt-4"><InquiryForm type="contact" /></div>
    </div>
  </section>
</BaseLayout>
