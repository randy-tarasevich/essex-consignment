---
// Consign With Us: based on the old site's "Ebay Items Wanted" page (Miles, Nov 24, 2026).
// Heading changed to "Other types of items that we accept" (Nov 25); "Submit Your Items" button jumps to the form.
// The old page showed the item list as an image; here it's real text styled to match,
// so it stays sharp, is readable by search engines, and works with the Spanish toggle.
// The consignment form (with photo upload) sits below the list (brought back Nov 25, 2026).
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { wanted } from '../data/consign.js';
import { site } from '../data/site.js';
const half = Math.ceil(wanted.length / 2);
const columns = [wanted.slice(0, half), wanted.slice(half)];
---
<BaseLayout title="Consign With Us" description="Essex Consignment wants your coins, comics, sports cards, sterling silver, jewelry, watches, designer bags, memorabilia, vintage toys, records, and more. eBay Top Rated Seller for 24 years.">
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-4 pt-10 pb-20 text-center sm:pt-12">
      <h1 class="text-[2rem] font-extrabold leading-tight tracking-tight text-burgundy-800 sm:text-5xl sm:leading-tight">
        Other types of items that we accept
      </h1>
      <a href="#consign-form"
        class="mt-8 inline-flex items-center gap-2 rounded-btn bg-burgundy-700 px-8 py-4 text-base font-bold uppercase tracking-[0.12em] text-white shadow-sm hover:bg-burgundy-800 transition-colors sm:text-lg">
        Submit Your Items <span aria-hidden="true">↓</span>
      </a>

      <div class="mt-12 grid justify-center gap-x-12 text-left text-[1.0625rem] leading-[1.6] text-black sm:grid-cols-[auto_auto]">
        {columns.map((col) => (
          <ul>
            {col.map(([lead, rest, line2]) => (
              <li><strong class="font-black">{lead}</strong> {rest}{line2 && <><br />{line2}</>}</li>
            ))}
          </ul>
        ))}
      </div>

      <a href={site.phoneHref}
        class="mt-14 inline-block rounded-btn bg-burgundy-800 px-6 py-3 text-base font-semibold text-white hover:bg-burgundy-900 transition-colors sm:px-12 sm:text-xl">
        {site.name} <span class="whitespace-nowrap">{site.phone}</span>
      </a>
      <p class="mt-3">
        <a href={`mailto:${site.email}`} class="text-lg font-bold text-burgundy-800 hover:underline sm:text-xl">{site.email}</a>
      </p>
    </div>
  </section>

  <!-- Consign With Us form: saves to Shopify tagged "consignor", photos go to R2 -->
  <section id="consign-form" class="scroll-mt-4 border-t border-burgundy-100" aria-labelledby="consign-form-heading">
    <div class="mx-auto max-w-xl px-4 py-12 sm:py-16">
      <h2 id="consign-form-heading" class="text-3xl font-bold">Consign with Us</h2>
      <p class="mt-2">Tell us what you have and attach a few photos if you can. We'll get back to you with next steps.</p>
      <p id="form-error" hidden class="mt-2 text-sm font-semibold text-red-700">Sorry, your message didn't go through. Please try again or call us.</p>
      <script is:inline>
        if (new URLSearchParams(location.search).has('error')) document.getElementById('form-error').hidden = false;
      </script>
      <div class="mt-6"><InquiryForm type="consignor" /></div>
    </div>
  </section>
</BaseLayout>
