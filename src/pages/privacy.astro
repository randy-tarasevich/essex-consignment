---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site.js';

// TODO before launch: Al reviews this page. Update `updated` if anything changes.
// If GA4 isn't live at launch, remove the "Site analytics" section.
const updated = 'January 1, 2027';
---
<BaseLayout title="Privacy Policy" description={`How ${site.name} collects and uses the information you share through this website.`}>
  <PageHeader title="Privacy Policy" intro={`Last updated ${updated}`} />
  <section class="mx-auto max-w-3xl px-4 py-12 space-y-8 leading-relaxed">
    <p>
      This policy explains what information {site.name} collects through essexconsignment.com, how we use it,
      and the choices you have. We keep it simple: we only collect what you choose to send us, and we never sell it.
    </p>

    <div class="space-y-3">
      <h2 class="font-serif text-2xl">What we collect</h2>
      <p>When you use our Contact or Consign With Us forms, we collect:</p>
      <ul class="list-disc pl-6 space-y-1">
        <li>Your first and last name</li>
        <li>Your email address</li>
        <li>Your phone number, if you give it</li>
        <li>Your message, including details about items you'd like to consign</li>
        <li>Whether you'd like emails about new arrivals and shop news</li>
      </ul>
      <p>We don't ask for payment details on this website. Purchases happen in our Shopify store (see below).</p>
    </div>

    <div class="space-y-3">
      <h2 class="font-serif text-2xl">How we use it</h2>
      <ul class="list-disc pl-6 space-y-1">
        <li>To reply to your question or consignment inquiry</li>
        <li>To keep a record of our conversations, so we can help you next time</li>
        <li>To send you emails about new arrivals and shop news, only if you checked that box</li>
      </ul>
    </div>

    <div class="space-y-3">
      <h2 class="font-serif text-2xl">Where it's stored and who helps us</h2>
      <p>We use a few trusted services to run this website. Each handles your information only to provide its service:</p>
      <ul class="list-disc pl-6 space-y-1">
        <li><strong>Shopify</strong> stores your contact details and messages in our customer records.</li>
        <li><strong>Web3Forms</strong> delivers an email copy of your message to us.</li>
        <li><strong>Cloudflare</strong> hosts this website and runs Turnstile, a spam check on our forms.</li>
        <li><strong>Google Analytics</strong> helps us understand how visitors use the site (see below).</li>
      </ul>
      <p>We don't sell, rent, or trade your information.</p>
    </div>

    <div class="space-y-3">
      <h2 class="font-serif text-2xl">Site analytics</h2>
      <p>
        We use Google Analytics to see which pages are visited and how people find us. It uses cookies and
        collects general information like your browser, device, and approximate location, not your name or email.
        You can opt out with Google's <a href="https://tools.google.com/dlpage/gaoptout" class="underline">browser add-on</a>
        or by blocking cookies in your browser.
      </p>
    </div>

    <div class="space-y-3">
      <h2 class="font-serif text-2xl">Our Shopify store</h2>
      <p>
        When you click an item to buy it, you go to our Shopify store. Orders, payments, and shipping details there
        are handled by Shopify and covered by the privacy policy shown in that store.
      </p>
    </div>

    <div class="space-y-3">
      <h2 class="font-serif text-2xl">Your choices</h2>
      <ul class="list-disc pl-6 space-y-1">
        <li>Every marketing email has an unsubscribe link.</li>
        <li>You can ask to see, correct, or delete the information we have about you.</li>
      </ul>
      <p>
        To make a request, email <a href={`mailto:${site.email}`} class="underline">{site.email}</a> or call
        <a href={site.phoneHref} class="underline">{site.phone}</a>.
      </p>
    </div>

    <div class="space-y-3">
      <h2 class="font-serif text-2xl">Children</h2>
      <p>This website isn't meant for children under 13, and we don't knowingly collect their information.</p>
    </div>

    <div class="space-y-3">
      <h2 class="font-serif text-2xl">Changes and contact</h2>
      <p>If we change this policy, we'll update the date at the top of this page. Questions? Contact us:</p>
      <address class="not-italic">
        {site.name}<br />
        {site.address.street}, {site.address.city}, {site.address.region} {site.address.postalCode}<br />
        <a href={site.phoneHref} class="underline">{site.phone}</a> ·
        <a href={`mailto:${site.email}`} class="underline">{site.email}</a>
      </address>
    </div>
  </section>
</BaseLayout>
