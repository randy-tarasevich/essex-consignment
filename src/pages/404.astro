---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found">
  <section class="mx-auto max-w-3xl px-4 py-24 text-center">
    <h1 class="text-4xl font-bold">Page not found</h1>
    <p class="mt-4">That page has moved or no longer exists.</p>
    <a href="/" class="mt-8 inline-block rounded-full bg-burgundy-700 px-6 py-3 font-semibold text-white">Back to home</a>
  </section>
</BaseLayout>
