---
// Homepage gallery: for-sale items, Shopify "Featured" collection first, topped up with the newest products.
// Shows 10 by default; the Category and Price filters (client request, Nov 16) search the whole pool.
// Filters are linkable: /?category=art&price=under-100#featured (the nav's Shop menu uses this).
// Each card links to its Shopify product page. Sold items drop off on the next build.
import { getFeaturedItems, DEFAULT_VISIBLE } from '../lib/shopify.js';
import { site, shopCategories, priceTiers } from '../data/site.js';

// The homepage opens with this gallery, so it carries the page's H1 there.
const { headingLevel = 'h2', eyebrow = '' } = Astro.props;
const Heading = headingLevel;

const { items, source } = await getFeaturedItems();
const placeholders = Array.from({ length: 10 }, (_, i) => ({ id: `p${i}`, title: `Featured item ${i + 1}`, price: '$—', url: '#', image: null, category: null, priceTier: null }));
const cards = items.length ? items : placeholders;
const note =
  source === 'mock' ? 'Preview: demo products from mock.shop'
  : items.length === 0 ? 'Preview: Shopify not connected yet'
  : '';

// Filters are dropdowns (client request, Nov 25): one toggle per group, options open in a panel below.
const filterGroups = [
  { key: 'category', label: 'Category', options: shopCategories },
  { key: 'price', label: 'Price', options: priceTiers },
];
const option = 'gallery-filter flex w-full items-center justify-between gap-6 px-4 py-2.5 text-left text-xs font-bold uppercase tracking-[0.12em] text-burgundy-800 hover:bg-burgundy-50 focus-visible:bg-burgundy-50 focus-visible:outline-none aria-pressed:bg-burgundy-700 aria-pressed:text-white';
---
<section id="featured" class="mx-auto max-w-6xl scroll-mt-4 px-4 pt-4 pb-12 sm:pt-5 sm:pb-16" aria-labelledby="featured-heading">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      {eyebrow && <p class="text-sm font-bold uppercase tracking-[0.2em] text-burgundy-700">{eyebrow}</p>}
      <div class="flex flex-wrap items-center gap-4 sm:gap-6">
        <Heading id="featured-heading" class:list={['text-3xl', headingLevel === 'h1' ? 'font-bold leading-none sm:text-5xl' : 'font-bold']}>Featured Items</Heading>
        <!-- Client request (Miles, Nov 24): big "Sell With Us" button beside the heading -->
        <a href="/contact/" class="inline-flex items-center gap-2 rounded-btn bg-burgundy-700 px-6 py-3 text-base font-bold uppercase tracking-[0.12em] text-white shadow-sm hover:bg-burgundy-800 transition-colors sm:px-8 sm:py-3 sm:text-lg">Sell With Us <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="flex flex-col items-end gap-2">
      {site.shopUrl && <a href={site.shopUrl} class="text-xs font-semibold uppercase tracking-[0.2em] text-burgundy-700 hover:underline">Shop all items →</a>}
      {note && <p class="text-xs text-burgundy-600">{note}</p>}
    </div>
  </div>

  <!-- Filters: Category and Price dropdowns -->
  <div class="mt-2 flex flex-col gap-3 border-y border-burgundy-100 py-2.5 sm:flex-row sm:items-center">
    {filterGroups.map((g) => (
      <div class="filter-dropdown relative w-full sm:w-auto" data-group={g.key}>
        <button
          type="button"
          id={`filter-${g.key}-toggle`}
          class="filter-toggle inline-flex w-full items-center justify-between gap-3 rounded-btn border border-burgundy-100 bg-white px-4 py-2.5 text-xs font-bold uppercase tracking-[0.12em] text-burgundy-800 hover:border-burgundy-700 aria-expanded:border-burgundy-700 sm:w-auto"
          aria-expanded="false"
          aria-controls={`filter-${g.key}-panel`}
        >
          <span><span class="mr-1 tracking-[0.2em] text-ink/70">{g.label}:</span> <span class="filter-current">All</span></span>
          <svg class="filter-chevron h-3 w-3 shrink-0 transition-transform" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" /></svg>
        </button>
        <div
          id={`filter-${g.key}-panel`}
          class="filter-panel absolute left-0 top-full z-20 mt-2 hidden w-full bg-white py-2 shadow-lg ring-1 ring-burgundy-100 sm:w-max sm:min-w-full"
          role="group"
          aria-label={`Filter by ${g.label.toLowerCase()}`}
        >
          <button type="button" class={option} data-filter={g.key} data-value="" data-label="All" aria-pressed="true">All<span class="filter-check" aria-hidden="true">✓</span></button>
          {g.options.map((o) => (
            <button type="button" class={option} data-filter={g.key} data-value={o.slug} data-label={o.label} aria-pressed="false" title={o.hint}>{o.label}<span class="filter-check" aria-hidden="true">✓</span></button>
          ))}
        </div>
      </div>
    ))}
  </div>
  <p id="gallery-status" class="mt-3 text-sm text-ink/70" aria-live="polite"></p>

  <ul id="gallery-grid" class="mt-6 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-5">
    {cards.map((item, i) => (
      <li
        class:list={['gallery-card group bg-white ring-1 ring-burgundy-100 overflow-hidden', i >= DEFAULT_VISIBLE && 'hidden']}
        data-category={item.category ?? ''}
        data-price={item.priceTier ?? ''}
        data-default={i < DEFAULT_VISIBLE ? '1' : undefined}
      >
        <a href={item.url} class="block h-full" target={item.url.startsWith('http') ? '_blank' : undefined} rel={item.url.startsWith('http') ? 'noopener' : undefined}>
          <div class="aspect-square bg-burgundy-50 overflow-hidden">
            {item.image && (
              <img
                src={item.image.src}
                alt={item.image.alt}
                width={item.image.width}
                height={item.image.height}
                loading={i < 5 ? 'eager' : 'lazy'}
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
            )}
          </div>
          <div class="p-4">
            <h3 class="gothic-bold text-lg leading-snug text-ink">{item.title}</h3>
            <p class="mt-1 text-base lining-nums tabular-nums text-burgundy-700">{item.price}</p>
            <span class="mt-3 inline-block text-xs font-semibold uppercase tracking-[0.2em] text-burgundy-700 group-hover:underline">View item →</span>
          </div>
        </a>
      </li>
    ))}
  </ul>
  <p id="gallery-empty" class="mt-6 hidden bg-white p-6 text-center ring-1 ring-burgundy-100">
    No pieces match those filters right now. New items arrive all the time — <a href="/contact/" class="font-semibold text-burgundy-700 underline">ask us what’s coming in</a>.
  </p>
</section>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.gallery-filter'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.gallery-card'));
  const empty = document.getElementById('gallery-empty');
  const status = document.getElementById('gallery-status');
  const dropdowns = Array.from(document.querySelectorAll<HTMLElement>('.filter-dropdown'));
  const state = { category: '', price: '' };

  function apply(updateUrl = true) {
    const filtering = Boolean(state.category || state.price);
    let shown = 0;
    for (const card of cards) {
      const match = filtering
        ? (!state.category || card.dataset.category === state.category) && (!state.price || card.dataset.price === state.price)
        : card.dataset.default === '1';
      card.classList.toggle('hidden', !match);
      if (match) shown++;
    }
    for (const b of buttons) {
      b.setAttribute('aria-pressed', String(state[b.dataset.filter as 'category' | 'price'] === b.dataset.value));
    }
    for (const dd of dropdowns) {
      const current = dd.querySelector<HTMLButtonElement>('.gallery-filter[aria-pressed="true"]');
      const label = dd.querySelector('.filter-current');
      if (label) label.textContent = current?.dataset.label ?? 'All';
    }
    empty?.classList.toggle('hidden', shown > 0);
    if (status) status.textContent = filtering ? `Showing ${shown} ${shown === 1 ? 'piece' : 'pieces'}` : '';
    if (updateUrl) {
      const url = new URL(location.href);
      for (const key of ['category', 'price'] as const) {
        if (state[key]) url.searchParams.set(key, state[key]);
        else url.searchParams.delete(key);
      }
      history.replaceState(null, '', url);
    }
  }

  // Dropdown open/close
  const parts = (dd: HTMLElement) => ({
    toggle: dd.querySelector<HTMLButtonElement>('.filter-toggle')!,
    panel: dd.querySelector<HTMLElement>('.filter-panel')!,
    options: Array.from(dd.querySelectorAll<HTMLButtonElement>('.gallery-filter')),
  });
  function setOpen(dd: HTMLElement, open: boolean, focusOption = false) {
    const { toggle, panel, options } = parts(dd);
    toggle.setAttribute('aria-expanded', String(open));
    panel.classList.toggle('hidden', !open);
    dd.querySelector('.filter-chevron')?.classList.toggle('rotate-180', open);
    if (open && focusOption) (options.find((o) => o.getAttribute('aria-pressed') === 'true') ?? options[0])?.focus();
  }
  const closeAll = (except?: HTMLElement) => dropdowns.forEach((dd) => dd !== except && setOpen(dd, false));

  for (const dd of dropdowns) {
    const { toggle, options } = parts(dd);
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      closeAll(dd);
      setOpen(dd, open, open);
    });
    toggle.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); closeAll(dd); setOpen(dd, true, true); }
    });
    dd.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(dd, false);
        toggle.focus();
        return;
      }
      if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
      const i = options.indexOf(document.activeElement as HTMLButtonElement);
      if (i === -1) return;
      e.preventDefault();
      options[(i + (e.key === 'ArrowDown' ? 1 : options.length - 1)) % options.length].focus();
    });
    // Close when focus leaves the dropdown (Tab away)
    dd.addEventListener('focusout', (e) => {
      if (!dd.contains(e.relatedTarget as Node | null)) setOpen(dd, false);
    });
  }
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.filter-dropdown')) closeAll();
  });

  for (const b of buttons) {
    b.addEventListener('click', () => {
      state[b.dataset.filter as 'category' | 'price'] = b.dataset.value ?? '';
      apply();
      const dd = b.closest<HTMLElement>('.filter-dropdown');
      if (dd) { setOpen(dd, false); parts(dd).toggle.focus(); }
    });
  }

  // Deep links from the nav's Shop menu: /?category=art#featured
  const params = new URLSearchParams(location.search);
  const valid = (key: string, v: string | null) => buttons.some((b) => b.dataset.filter === key && b.dataset.value === v);
  if (valid('category', params.get('category'))) state.category = params.get('category')!;
  if (valid('price', params.get('price'))) state.price = params.get('price')!;
  if (state.category || state.price) apply(false);
</script>

<style>
  /* Checkmark only on the active option */
  .gallery-filter[aria-pressed='false'] .filter-check { visibility: hidden; }
</style>
