---
// Homepage gallery: 10 for-sale items, Shopify "Featured" collection first, topped up with the newest products.
// Each card links to its Shopify product page. Sold items drop off on the next build.
import { getFeaturedItems } from '../lib/shopify.js';

const { items, source } = await getFeaturedItems();
const placeholders = Array.from({ length: 10 }, (_, i) => ({ id: `p${i}`, title: `Featured item ${i + 1}`, price: '$—', url: '#', image: null }));
const cards = items.length ? items : placeholders;
const note =
  source === 'mock' ? 'Preview: demo products from mock.shop'
  : items.length === 0 ? 'Preview: Shopify not connected yet'
  : '';
---
<section class="mx-auto max-w-6xl px-4 py-16" aria-labelledby="featured-heading">
  <div class="flex items-end justify-between gap-4">
    <h2 id="featured-heading" class="text-3xl font-bold">Featured Items</h2>
    {note && <p class="text-xs text-burgundy-600">{note}</p>}
  </div>
  <ul class="mt-8 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-5">
    {cards.map((item, i) => (
      <li class="group bg-white ring-1 ring-burgundy-100 overflow-hidden">
        <a href={item.url} class="block h-full" target={item.url.startsWith('http') ? '_blank' : undefined} rel={item.url.startsWith('http') ? 'noopener' : undefined}>
          <div class="aspect-square bg-burgundy-50 overflow-hidden">
            {item.image && (
              <img
                src={item.image.src}
                alt={item.image.alt}
                width={item.image.width}
                height={item.image.height}
                loading={i < 5 ? 'eager' : 'lazy'}
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
            )}
          </div>
          <div class="p-4">
            <h3 class="text-lg font-medium leading-snug text-ink">{item.title}</h3>
            <p class="mt-1 text-base lining-nums tabular-nums text-burgundy-700">{item.price}</p>
            <span class="mt-3 inline-block text-xs font-semibold uppercase tracking-[0.2em] text-burgundy-700 group-hover:underline">Shop now →</span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>
