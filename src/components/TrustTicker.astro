---
// Trust banner above the homepage Featured Items (Miles, Nov 24, 2026): the three stats plus
// the eBay and Google badges. Static since Nov 25 (client request): all five items visible at once,
// one row on desktop, wrapping to centered rows on smaller screens.
import { site } from '../data/site.js';
import { stats } from '../data/consign.js';
const { rating, reviewCount, reviewsUrl } = site.google;
const items = [
  ...stats.map((s) => ({ value: s.value, label: s.label })),
  { stars: true, value: '5-Star eBay Seller', label: 'Visit our eBay store', href: site.ebayUrl },
  { stars: true, value: `${rating} on Google`, label: `${reviewCount} five-star reviews`, href: reviewsUrl },
];
---
<section class="border-b border-burgundy-100 bg-white" aria-label="Essex Consignment by the numbers">
  <ul class="mx-auto flex max-w-6xl flex-wrap justify-center px-4 py-1">
    {items.map((it) => {
      const Tag = it.href ? 'a' : 'div';
      return (
        <li class="basis-1/2 sm:basis-1/3 lg:flex-1 lg:basis-0 lg:border-l lg:border-burgundy-100 lg:first:border-l-0">
          <Tag
            {...(it.href && { href: it.href, target: '_blank', rel: 'noopener' })}
            class:list={['flex h-full flex-col items-center justify-center px-3 py-1.5 text-center', it.href && 'group']}
          >
            {it.stars && <span class="text-base leading-none tracking-tight text-gold" aria-hidden="true">★★★★★</span>}
            <span class="gothic-bold mt-1 text-xl leading-tight lining-nums text-burgundy-800 sm:text-2xl lg:whitespace-nowrap lg:text-xl xl:text-2xl">{it.value}</span>
            <span class="mt-1 text-xs font-semibold uppercase tracking-wide text-ink group-hover:text-burgundy-600 group-hover:underline">{it.label}</span>
          </Tag>
        </li>
      );
    })}
  </ul>
</section>
