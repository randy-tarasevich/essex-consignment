---
// Shared form for Contact and Consign With Us.
// Posts to the Worker at /api/inquiry, which saves the person as a Shopify customer
// tagged "website-contact" or "consignor" and emails a notification.
// Works without JavaScript (redirects to /thank-you/); with JavaScript it shows the result inline.
const { type = 'contact' } = Astro.props; // 'contact' | 'consignor'
const isConsignor = type === 'consignor';
// Photo upload (Miles, Nov 24, 2026): on both forms (added to Consign With Us Nov 25). Photos go to R2 via the Worker.
const { photos = true } = Astro.props;
// Turnstile site key is public. Real key covers essexconsignment.com + the workers.dev staging URL;
// local dev uses Cloudflare's always-pass invisible test key so the widget works on localhost.
// The widget is hidden (appearance: interaction-only, Nov 25) and only shows if Cloudflare asks a visitor to click.
const TURNSTILE_SITE_KEY = '0x4AAAAAAF05rsXl12KtrHVR';
const TURNSTILE_TEST_KEY = '1x00000000000000000000BB';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || (import.meta.env.DEV ? TURNSTILE_TEST_KEY : TURNSTILE_SITE_KEY);
// Web3Forms "Essex Consignment" form (public key). Sends to info@shorelinewebsolutionsct.com during
// development; switch to a key that sends to al@essexconsignment.com at launch.
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY || '154ab7cf-7f4c-4172-b72c-3974e1ad6648';
// card: the boxed "Show us what you got!" style used on Consign With Us (Nov 25, 2026). Contact keeps the plain style.
const { card = false } = Astro.props;
const plainField = 'mt-1 w-full border border-burgundy-100 bg-white px-3 py-2 font-normal';
const cardInput = 'mt-2 block w-full border border-stone-300 bg-white px-3.5 text-base font-normal focus:outline-2 focus:outline-offset-1 focus:outline-burgundy-800';
const field = card ? `${cardInput} h-[46px]` : plainField;
const area = card ? `${cardInput} py-3 leading-normal placeholder:text-stone-400` : plainField;
const label = card ? 'block text-[0.9375rem] font-semibold' : 'block text-sm font-semibold';
const optional = card ? 'font-normal text-stone-500' : 'font-normal text-burgundy-600';
---
<form class={`inquiry-form ${card ? 'space-y-5' : 'space-y-4 max-w-xl'}`} method="post" action="/api/inquiry" enctype="multipart/form-data" data-notify-key={web3formsKey} novalidate>
  <input type="hidden" name="type" value={type} />

  <!-- Honeypot: hidden from people, filled in by bots -->
  <div class="absolute -left-[9999px]" aria-hidden="true">
    <label>Company website <input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <label class={label}>First name
      <input name="firstName" required maxlength="80" autocomplete="given-name" class={field} />
    </label>
    <label class={label}>Last name
      <input name="lastName" required maxlength="80" autocomplete="family-name" class={field} />
    </label>
  </div>
  <div class={card ? 'grid gap-4 sm:grid-cols-2' : 'space-y-4'}>
    <label class={label}>Email
      <input type="email" name="email" required maxlength="254" autocomplete="email" class={field} />
    </label>
    <label class={label}>Phone <span class={optional}>(optional)</span>
      <input type="tel" name="phone" maxlength="40" autocomplete="tel" class={field} />
    </label>
  </div>
  <label class={label}>{isConsignor ? 'What would you like to consign?' : 'Message'}
    <textarea name="message" rows={card ? 4 : 5} required maxlength="4000" class={area}
      placeholder={card && isConsignor ? "e.g. Sterling flatware set, a pair of mid-century lamps, my dad's coin collection…" : undefined}></textarea>
  </label>
  {photos && (card ? (
    <label class={label}>Photos <span class={optional}>(optional, up to 5)</span>
      <span class="mt-2 flex cursor-pointer flex-col items-center gap-1.5 border-[1.5px] border-dashed border-[#c9b3b7] bg-[#fbf8f7] px-4 py-6 text-center transition-colors hover:bg-burgundy-50 has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-burgundy-800">
        <svg aria-hidden="true" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-burgundy-800"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
        <span class="text-base font-bold text-burgundy-800">Add photos</span>
        <span class="text-sm font-normal text-stone-600">Take a picture or choose from your phone or computer</span>
        <input type="file" name="photos" accept="image/*" multiple class="sr-only" />
      </span>
      <span class="photo-status mt-1 block text-xs font-normal text-burgundy-600" aria-live="polite"></span>
    </label>
  ) : (
    <label class="block text-sm font-semibold">Photos of your item(s) <span class="font-normal text-burgundy-600">(optional, up to 5)</span>
      <input type="file" name="photos" accept="image/*" multiple
        class="mt-1 block w-full border border-burgundy-100 bg-white px-3 py-2 font-normal file:mr-3 file:rounded-btn file:border-0 file:bg-burgundy-700 file:px-4 file:py-2 file:font-semibold file:text-white hover:file:bg-burgundy-800" />
      <span class="photo-status mt-1 block text-xs font-normal text-burgundy-600" aria-live="polite"></span>
    </label>
  ))}
  <label class={card ? 'flex min-h-11 items-center gap-3 text-[0.9375rem]' : 'flex items-start gap-2 text-sm'}>
    <input type="checkbox" name="acceptsMarketing" class={card ? 'size-5 accent-burgundy-800' : 'mt-1'} />
    <span>Email me about new arrivals and shop news.</span>
  </label>
  <p class="text-xs text-burgundy-600">We use your details only to reply and never sell them. See our <a href="/privacy/" class="underline">Privacy Policy</a>.</p>

  {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light" data-appearance="interaction-only"></div>}

  <button type="submit" class={card
    ? 'h-[54px] w-full bg-burgundy-800 text-[1.0625rem] font-bold text-white hover:bg-burgundy-900 disabled:opacity-60'
    : 'rounded-btn bg-burgundy-700 px-6 py-3 font-semibold text-white hover:bg-burgundy-800 disabled:opacity-60'}>
    {isConsignor ? 'Send consignment inquiry' : 'Send message'}
  </button>
  <p class="form-status text-sm" role="status" aria-live="polite"></p>
</form>

{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  const MAX_PHOTOS = 5;
  const MAX_PHOTO_BYTES = 10 * 1024 * 1024;

  // Phone photos are often 3-12 MB. Shrink large JPG/PNG/WEBP photos to 2000px JPEGs before
  // sending; anything the browser can't decode (e.g. HEIC on some browsers) is sent as-is.
  async function shrink(file) {
    if (file.size < 1.5 * 1024 * 1024 || !/^image\/(jpeg|png|webp)$/.test(file.type)) return file;
    try {
      const bitmap = await createImageBitmap(file, { imageOrientation: 'from-image' });
      const scale = Math.min(1, 2000 / Math.max(bitmap.width, bitmap.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(bitmap.width * scale);
      canvas.height = Math.round(bitmap.height * scale);
      canvas.getContext('2d').drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      bitmap.close?.();
      const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/jpeg', 0.85));
      if (!blob || blob.size >= file.size) return file;
      return new File([blob], file.name.replace(/\.\w+$/, '') + '.jpg', { type: 'image/jpeg' });
    } catch {
      return file;
    }
  }

  // Checks the chosen photos; returns an error message or ''.
  function photoProblem(input) {
    const files = Array.from(input?.files || []);
    if (files.length > MAX_PHOTOS) return `Please choose no more than ${MAX_PHOTOS} photos.`;
    if (files.some((f) => !f.type.startsWith('image/') && !/\.(heic|heif)$/i.test(f.name))) return 'Please choose image files only.';
    return '';
  }

  for (const input of document.querySelectorAll('form.inquiry-form input[name="photos"]')) {
    input.addEventListener('change', () => {
      const note = input.closest('label').querySelector('.photo-status');
      const problem = photoProblem(input);
      const n = input.files.length;
      note.className = `photo-status mt-1 block text-xs ${problem ? 'font-semibold text-red-700' : 'font-normal text-burgundy-600'}`;
      note.textContent = problem || (n ? `${n} photo${n === 1 ? '' : 's'} selected` : '');
    });
  }

  // Sends the email notification from the browser (Web3Forms free plan only accepts browser submissions).
  async function notify(form, data, saved, photos = [], photoError = false) {
    const key = form.dataset.notifyKey;
    if (!key) return false;
    const consignor = data.get('type') === 'consignor';
    const name = `${data.get('firstName')} ${data.get('lastName')}`.trim();
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: key,
          subject: `${consignor ? 'New consignment inquiry' : 'New website message'} from ${name}`,
          from_name: 'Essex Consignment website',
          replyto: data.get('email'),
          name,
          email: data.get('email'),
          phone: data.get('phone') || '(not given)',
          message: data.get('message'),
          email_updates: data.get('acceptsMarketing') ? 'Yes' : 'No',
          ...(form.querySelector('input[name="photos"]') && {
            photos: photoError
              ? 'The customer attached photos, but they failed to upload. Ask them to email the photos.'
              : photos.length ? photos.join('\n') : 'None',
          }),
          shopify: saved
            ? `Saved to Shopify (tagged "${consignor ? 'consignor' : 'website-contact'}").`
            : 'NOT saved to Shopify. Please add this person by hand.',
        }),
      });
      const out = await res.json().catch(() => ({}));
      return res.ok && out.success !== false;
    } catch {
      return false;
    }
  }

  for (const form of document.querySelectorAll('form.inquiry-form')) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const status = form.querySelector('.form-status');
      const button = form.querySelector('button[type="submit"]');
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const show = (ok, text) => {
        status.className = `form-status text-sm font-semibold ${ok ? 'text-green-800' : 'text-red-700'}`;
        status.textContent = text;
      };
      const photoInput = form.querySelector('input[name="photos"]');
      const problem = photoProblem(photoInput);
      if (problem) {
        show(false, problem);
        return;
      }
      button.disabled = true;
      status.className = 'form-status text-sm';
      status.textContent = 'Sending…';
      const data = new FormData(form);
      try {
        if (photoInput) {
          data.delete('photos');
          const chosen = Array.from(photoInput.files || []);
          if (chosen.length) status.textContent = 'Preparing photos…';
          for (const file of chosen) {
            const small = await shrink(file);
            if (small.size > MAX_PHOTO_BYTES) {
              show(false, `"${file.name}" is too large. Each photo must be under 10 MB.`);
              return;
            }
            data.append('photos', small, small.name);
          }
          if (chosen.length) status.textContent = 'Sending…';
        }
        const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        const out = await res.json().catch(() => ({}));
        if (res.ok && out.ok) {
          await notify(form, data, true, out.photos, out.photoError);
          form.reset();
          form.querySelector('.photo-status')?.replaceChildren();
          show(true, out.photoError
            ? 'Thanks! We got your message, but your photos did not upload. Please email them to us.'
            : out.message || 'Thanks! We will be in touch soon.');
        } else if (out.saved === false) {
          // Shopify was unavailable: the email still delivers the inquiry.
          const emailed = await notify(form, data, false, out.photos, out.photoError);
          if (emailed) {
            form.reset();
            show(true, 'Thanks! We received your message and will be in touch soon.');
          } else {
            show(false, out.message || 'Something went wrong. Please call us at (860) 767-9741.');
          }
        } else {
          show(false, out.message || 'Something went wrong. Please call us at (860) 767-9741.');
        }
      } catch {
        show(false, 'Could not send. Please check your connection or call us at (860) 767-9741.');
      } finally {
        button.disabled = false;
        window.turnstile?.reset?.();
      }
    });
  }
</script>
