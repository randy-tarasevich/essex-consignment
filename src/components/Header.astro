---
import { Image } from 'astro:assets';
import { site, nav } from '../data/site.js';
import logo from '../assets/logo.png';
const current = Astro.url.pathname;
---
<header class="bg-white border-b border-burgundy-100">
  <div class="mx-auto max-w-6xl px-4 py-2 nav:py-4 flex items-center justify-between gap-4">
    <a href="/" class="shrink-0" aria-label={`${site.name} home`}>
      <Image src={logo} alt={site.name} height={72} densities={[1, 2]} loading="eager" fetchpriority="high" class="h-14 nav:h-[72px] w-auto" />
    </a>

    <!-- Desktop nav -->
    <nav aria-label="Main" class="hidden nav:block">
      <ul class="flex flex-wrap gap-x-8 gap-y-2 text-xs font-semibold uppercase tracking-[0.2em]">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['hover:text-burgundy-600', current === item.href && 'text-burgundy-700 underline underline-offset-4']}
              aria-current={current === item.href ? 'page' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <a href={site.phoneHref} class="hidden nav:inline-block rounded-btn bg-burgundy-700 px-4 py-2 text-sm font-semibold tracking-wider text-white hover:bg-burgundy-800">
      {site.phone}
    </a>

    <!-- Mobile: call + menu buttons -->
    <div class="flex items-center gap-2 nav:hidden">
      <a href={site.phoneHref} class="inline-flex h-11 w-11 items-center justify-center rounded-btn bg-burgundy-700 text-white" aria-label={`Call ${site.phone}`}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
      </a>
      <button type="button" id="menu-toggle" aria-expanded="false" aria-controls="mobile-menu" class="inline-flex h-11 w-11 items-center justify-center rounded-btn border border-burgundy-100 text-burgundy-800">
        <span class="sr-only">Menu</span>
        <svg id="menu-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6" aria-hidden="true"><path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg id="menu-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden h-6 w-6" aria-hidden="true"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu panel -->
  <nav id="mobile-menu" aria-label="Main" class="hidden border-t border-burgundy-100 nav:hidden">
    <ul class="mx-auto max-w-6xl px-4 py-2 text-sm font-semibold uppercase tracking-[0.2em]">
      {nav.map((item) => (
        <li class="border-b border-burgundy-50 last:border-0">
          <a
            href={item.href}
            class:list={['block py-3', current === item.href && 'text-burgundy-700']}
            aria-current={current === item.href ? 'page' : undefined}
          >{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    menu?.classList.toggle('hidden', open);
    document.getElementById('menu-open')?.classList.toggle('hidden', !open);
    document.getElementById('menu-close')?.classList.toggle('hidden', open);
  });
</script>
