# Copy to .dev.vars for local Worker testing (npm run preview:worker). Never commit .dev.vars.
SHOPIFY_STORE_DOMAIN=your-dev-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=
# or, for a Dev Dashboard app:
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# Turnstile test secret that always passes (Cloudflare's documented test key)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
