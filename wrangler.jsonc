// Cloudflare Worker: serves the Astro build from ./dist and handles /api/* (form submissions, Shopify webhooks).
{
  "name": "essex-consignment",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // Public staging URL (essex-consignment.<subdomain>.workers.dev) and per-branch preview URLs
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only API requests run the Worker; everything else is served straight from ./dist
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Plain (non-secret) runtime settings. Secrets (TURNSTILE_SECRET_KEY, SHOPIFY_CLIENT_ID/SECRET,
  // SHOPIFY_WEBHOOK_SECRET, DEPLOY_HOOK_URL) live in the Cloudflare dashboard, never in this file.
  "vars": {
    "SHOPIFY_STORE_DOMAIN": "essexconsignment.myshopify.com"
  },
  // Debounces Shopify webhooks into one site rebuild (see RebuildDebouncer in worker/index.js)
  "durable_objects": {
    "bindings": [{ "name": "REBUILD_DEBOUNCER", "class_name": "RebuildDebouncer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RebuildDebouncer"] }]
}
