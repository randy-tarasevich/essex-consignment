# Shopify Storefront API (read-only). Used at build time only.
# Store domain, e.g. essex-consignment.myshopify.com
PUBLIC_SHOPIFY_STORE_DOMAIN=
# Storefront API public access token (from the Headless channel or a custom app)
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
# Optional: API version (default 2026-10)
# PUBLIC_SHOPIFY_API_VERSION=2026-10
# Optional: use Shopify's public demo store (mock.shop) in a production build
# PUBLIC_SHOPIFY_USE_MOCK=true

# Optional: override the Turnstile site key (the real one is in InquiryForm.astro).
# PUBLIC_TURNSTILE_SITE_KEY=
# Optional: override the Web3Forms access key (default is in InquiryForm.astro).
# PUBLIC_WEB3FORMS_ACCESS_KEY=
